  "story": {
    "chapter1": {
      "chapter-title": "Chapter One: Arrival at the Fief",
      "intro-bells": "On a rainy night, the bells of the royal capital struck twelve.",
      "intro-crest": "Your family crest was taken down from the council hall wall. The old nobles watched coldly, while trade guild delegates laughed under their breath.",
      "intro-mist": "\"New Haven? A fief swallowed by sea fog dares call itself a domain?\"",
      "intro-contract": "You stood outside the door, clutching the sailing contract your father left behind.",
      "intro-assets": "It was a yellowed piece of parchment listing your family's last assets: an abandoned harbor, a stretch of barren land, and a few trade routes nearly cut off from the world.",
      "intro-exile": "Everyone believed this was exile.",
      "intro-last-words": "But before he died, your father left only one sentence: \"Do not look back. Go to New Haven. That is where our family truly begins.\"",
      "intro-boat": "Before dawn, you boarded a worn little boat.",
      "intro-owner": "The lights of the royal capital faded behind you. At the edge of the horizon, a forgotten harbor waited for its new master.",
      "arrival-boat": "The worn little boat slowly drew alongside the dock.",
      "arrival-cloak": "The sea breeze lifted your faded noble cloak. This was the fief you had inherited.",
      "arrival-name": "New Haven",
      "cecil-shadow": "Young Lord, welcome back to your fief. Though it holds only barren fields, an old warehouse, and a few trade roads no one dares travel... it still belongs to your family.",
      "cecil-shadowSpeaker": "???",
      "cecil-reveal": "The late lord entrusted me to support you, and to serve as your guardian. My name is Cecil Ashwing. Welcome to New Haven.",
      "cecil-revealSpeaker": "Cecil Ashwing",
      "choice-doubt": "How will you answer?",
      "choice-doubtA": "No one believes in this place?",
      "choice-doubtB": "Mother.",
      "doubt-a": "Yes. The people in the capital all say this fief has no value left.",
      "doubt-b-silence": "...",
      "doubt-b-complex": "Young Lord, please do not make our guardianship so complicated on the first day of our family revival.",
      "doubt-b-vow": "However... if that is your command, I shall guard you in the name of Ashwing until the stars fall into the sea and the royal banner returns.",
      "young-perfect": "Perfect.",
      "young-perfectSpeaker": "Young Lord",
      "narrator-smile": "You smiled softly and looked toward the silent harbor in the distance.",
      "young-ambition": "If no one is fighting for it, then this is exactly where I can make my mark.",
      "young-ambitionSpeaker": "Young Lord",
      "choice-cecil": "What will you call her?",
      "choice-cecilA": "Then I'll be counting on you, Lady Cecil.",
      "choice-cecilB": "Then I'll be counting on you, Little Ash.",
      "cecil-a": "As you command, Young Lord. From this day forth, I will assist you in rebuilding the fief.",
      "cecil-b-name": "...We can discuss forms of address another time.",
      "cecil-b-record": "But if this is the command of New Haven's future ruler, I will remember it.",
      "young-richest": "Starting today, this place will become the richest land in the kingdom once again.",
      "young-richestSpeaker": "Young Lord",
      "system-objective": "New Tutorial Objective Unlocked: Repair the old dock and rebuild your first warehouse.",
      "system-objectiveSpeaker": "System",
      "continue": "Continue",
      "beginBuilding": "Begin Building"
    }
